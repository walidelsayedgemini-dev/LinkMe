# ==========================================
# Link Me — إعدادات البيئة (Environment Variables)
# ==========================================

# المنفذ الذي يعمل عليه السيرفر
PORT=3000
NODE_ENV=development

# رابط الاتصال بقاعدة بيانات MySQL
# مثال محلي: mysql://root:root@localhost:3306/linkme_db
# مثال إنتاج / سحابي: mysql://user:password@host:3306/linkme_db
DATABASE_URL=mysql://root:root@localhost:3306/linkme_db

# المفتاح السري لتشفير الجلسات والـ JWT (يجب أن يكون 32 حرفاً على الأقل في الإنتاج)
JWT_SECRET=linkme-super-secret-jwt-key-2026-development-mode-secure

# إعدادات حساب فودافون كاش وإنستاباي المعتمدة
VODAFONE_CASH_NUMBER=01022412243
VODAFONE_CASH_NAME=Link Me Academy
INSTAPAY_USERNAME=linkme@instapay

# (اختياري) مسار تخزين الملفات والمرفقات السحابية في حال عدم استخدام التخزين المحلي uploads/
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
