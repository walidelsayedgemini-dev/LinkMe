<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <script type="module">import { injectIntoGlobalHook } from "/@react-refresh";
injectIntoGlobalHook(window);
window.$RefreshReg$ = () => {};
window.$RefreshSig$ = () => (type) => type;</script>

    <script type="module" src="/@vite/client"></script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5" />
    <title>Link Me — منصة كورسات اللغة الإنجليزية</title>
    <meta
      name="description"
      content="Link Me: كورسات إنجليزية بشرح عربي — محادثة، قواعد، آيلتس، إنجليزي أعمال ونطق. دروس عملية، تقدم محفوظ، ومدرّسون بخبرة حقيقية."
    />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:title" content="Link Me — تكلّم إنجليزي بثقة" />
    <meta property="og:description" content="منصة كورسات إنجليزية عربية: محادثة، قواعد، آيلتس، أعمال ونطق." />
    <meta property="og:type" content="website" />
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48'%3E%3Crect width='48' height='48' rx='13' fill='%232563ff'/%3E%3Cg fill='none' stroke='%23ffffff' stroke-width='4' stroke-linecap='round'%3E%3Cpath d='M11.5 12.5v23'/%3E%3Cpath d='M19.5 35.5V24a4.6 4.6 0 0 1 9.2 0v11.5'/%3E%3Cpath d='M28.7 24a4.6 4.6 0 0 1 9.2 0v11.5'/%3E%3C/g%3E%3Cpath d='M11.5 30h8' stroke='%23bcd4ff' stroke-width='3.2' stroke-linecap='round' fill='none'/%3E%3C/svg%3E"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=Instrument+Serif:ital@1&family=Space+Grotesk:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <script>
      // Apply the saved theme before first paint so the splash and app match.
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var dark = stored ? stored === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
          if (dark) document.documentElement.classList.add("dark");
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute("content", dark ? "#070f1c" : "#ffffff");
        } catch (e) {}
      })();
    </script>
    <style>
      /* ---------- Boot splash: animated Link Me logo ---------- */
      #lm-splash {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 18px;
        background: #ffffff;
        color: #0a1b33;
        font-family: "Space Grotesk", "Segoe UI", system-ui, sans-serif;
        transition: opacity 0.55s ease, visibility 0.55s ease;
      }
      html.dark #lm-splash {
        background: #070f1c;
        color: #e8f0ff;
      }
      #lm-splash.lm-done {
        opacity: 0;
        visibility: hidden;
      }
      .lm-splash-mark {
        width: 84px;
        height: 84px;
        animation: lm-pop 0.9s cubic-bezier(0.2, 0.9, 0.2, 1.1) both;
      }
      .lm-letters {
        transform-box: view-box;
        transform-origin: 26px 24px;
        animation: lm-breathe 2.2s ease-in-out infinite;
      }
      .lm-node {
        transform-box: fill-box;
        transform-origin: center;
        animation: lm-node-pulse 2.2s ease-in-out infinite;
      }
      .lm-word {
        display: flex;
        gap: 1px;
        font-size: 30px;
        font-weight: 700;
        letter-spacing: -0.02em;
        direction: ltr;
      }
      .lm-word span {
        display: inline-block;
        opacity: 0;
        transform: translateY(10px);
        animation: lm-letter 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
      }
      .lm-word span:nth-child(1) { animation-delay: 0.18s; }
      .lm-word span:nth-child(2) { animation-delay: 0.26s; }
      .lm-word span:nth-child(3) { animation-delay: 0.34s; }
      .lm-word span:nth-child(4) { animation-delay: 0.42s; }
      .lm-word span:nth-child(5) { animation-delay: 0.5s; }
      .lm-word span:nth-child(6) { animation-delay: 0.58s; }
      .lm-word .lm-accent { color: #2563ff; }
      html.dark .lm-word .lm-accent { color: #8fb4ff; }
      .lm-tag {
        font-family: "IBM Plex Sans Arabic", system-ui, sans-serif;
        font-size: 12px;
        opacity: 0;
        animation: lm-letter 0.6s ease 0.7s forwards;
        color: #5a6b85;
      }
      html.dark .lm-tag { color: #93a6c4; }
      .lm-bar {
        width: 132px;
        height: 3px;
        border-radius: 999px;
        background: rgba(37, 99, 255, 0.15);
        overflow: hidden;
      }
      .lm-bar i {
        display: block;
        height: 100%;
        width: 40%;
        border-radius: 999px;
        background: #2563ff;
        animation: lm-slide 1.1s ease-in-out infinite;
      }
      html.dark .lm-bar { background: rgba(143, 180, 255, 0.18); }
      html.dark .lm-bar i { background: #8fb4ff; }
      @keyframes lm-breathe {
        0%, 100% { transform: translateY(0) scale(1); }
        50% { transform: translateY(-1.5px) scale(1.03); }
      }
      @keyframes lm-node-pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.45; transform: scale(0.8); }
      }
      @keyframes lm-pop {
        from { opacity: 0; transform: scale(0.6) rotate(-12deg); }
        to { opacity: 1; transform: scale(1) rotate(0deg); }
      }
      @keyframes lm-letter {
        to { opacity: 1; transform: translateY(0); }
      }
      @keyframes lm-slide {
        0% { transform: translateX(-120%); }
        100% { transform: translateX(320%); }
      }
      @media (prefers-reduced-motion: reduce) {
        .lm-letters, .lm-node, .lm-bar i { animation: none; }
      }
    </style>
    <script src="/__manus__/debug-collector.js"></script>
  </head>

  <body>
    <div id="lm-splash" aria-hidden="true">
      <svg class="lm-splash-mark" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg">
        <rect width="40" height="40" rx="11" fill="#2563ff" />
        <g class="lm-letters" fill="none" stroke="#ffffff" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7.5 7v26" />
          <path d="M7.5 17a4.25 4.25 0 0 1 8.5 0v16" />
          <path d="M16 17a4.25 4.25 0 0 1 8.5 0v16" />
        </g>
        <circle class="lm-node" cx="30" cy="31" r="2.3" fill="#bcd4ff" />
      </svg>
      <div class="lm-word" aria-label="Link Me">
        <span>l</span><span>i</span><span>n</span><span>k</span><span class="lm-accent">m</span><span class="lm-accent">e</span>
      </div>
      <div class="lm-tag">كورسات إنجليزية بالعربي</div>
      <div class="lm-bar"><i></i></div>
    </div>
    <div id="root"></div>
    <script>
      // Hide the splash as soon as the app has mounted (with a safety timeout).
      window.__lmHideSplash = function () {
        var el = document.getElementById("lm-splash");
        if (!el) return;
        el.classList.add("lm-done");
        setTimeout(function () {
          if (el.parentNode) el.parentNode.removeChild(el);
        }, 700);
      };
      setTimeout(function () {
        if (window.__lmHideSplash) window.__lmHideSplash();
      }, 6000);
    </script>
    <script src="/api/platform/config.js"></script>
    <script type="module" src="/src/main.tsx?v=UokYW_B7Hn5qi0HRc4Zc9"></script>
  </body>
</html>
